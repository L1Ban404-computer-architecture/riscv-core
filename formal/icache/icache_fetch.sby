[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 20
cover: mode cover
cover: depth 20

[engines]
bmc: smtbmc bitwuzla
cover: smtbmc bitwuzla

[script]
plugin -i slang
read_slang --no-synthesis-define --single-unit --top fv_icache_fetch -f formal/icache/icache_fetch.f
prep -top fv_icache_fetch

[files]
formal/icache/icache_fetch.f formal/icache/icache_fetch.f
rtl/bus rtl/bus
rtl/common rtl/common
rtl/icache rtl/icache
formal/icache/fv_axi_rom.sv formal/icache/fv_axi_rom.sv
formal/icache/fv_cpu_fetch.sv formal/icache/fv_cpu_fetch.sv
formal/icache/fv_icache_fetch.sv formal/icache/fv_icache_fetch.sv
formal/icache/fv_imem.sv formal/icache/fv_imem.sv
formal/icache/fv_scoreboard.sv formal/icache/fv_scoreboard.sv
