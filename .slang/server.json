{
  "build": ".slang/riscv_core.f",
  "buildRelativePaths": false,
  "flags": "-Wno-empty-output-connection",
  "builds": [
    {
      "name": "riscv_core",
      "glob": ".slang/riscv_core.f"
    },
    {
      "name": "cache_dev",
      "glob": ".slang/cache_dev.f"
    }
  ],
  "index": [
    {
      "dirs": [
        "rtl/common",
        "rtl/bus",
        "rtl/core",
        "rtl/core/pipeline",
        "rtl/core/units",
        "rtl/cache",
        "rtl/cache_dev",
        "rtl/cache_dev/tb",
        "rtl/peripheral",
        "rtl/top"
      ],
      "excludeDirs": []
    }
  ]
}
